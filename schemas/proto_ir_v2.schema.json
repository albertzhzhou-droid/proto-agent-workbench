{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proto Agent DNA IR v2 source placements",
  "type": "object",
  "required": ["schema_version", "domain", "design_id", "chassis", "constructs", "constraints", "provenance"],
  "properties": {
    "schema_version": {"const": "proto-agent.ir.v2"},
    "domain": {"const": "dna"},
    "design_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "chassis": {"type": "string", "minLength": 1, "maxLength": 256},
    "constructs": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["name", "topology", "parts", "sequence", "length", "sequence_sha256", "annotations"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "topology": {"enum": ["linear", "circular", "unknown"]},
          "sequence": {"type": "string", "pattern": "^[ACGTRYSWKMBDHVN]+$", "maxLength": 10000000},
          "length": {"type": "integer", "minimum": 1, "maximum": 10000000},
          "sequence_sha256": {"$ref": "#/$defs/sha256"},
          "parts": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/occurrence"}},
          "annotations": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/annotation"}}
        },
        "additionalProperties": false
      }
    },
    "constraints": {"type": "array", "maxItems": 10000, "items": {"type": "object", "required": ["type"]}},
    "provenance": {"type": "object", "required": ["source"], "properties": {"source": {"type": "string", "minLength": 1}}}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "local_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
    "span": {
      "type": "object", "required": ["instance_id", "start", "end", "direction"],
      "properties": {
        "instance_id": {"$ref": "#/$defs/local_id"},
        "start": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "end": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "direction": {"type": "integer", "enum": [-1, 0, 1]}
      }, "additionalProperties": false
    },
    "occurrence": {
      "type": "object",
      "required": ["type", "id", "instance_id", "sequence", "sequence_sha256", "source_sequence_sha256", "placement", "source_direction", "direction", "start", "end"],
      "properties": {
        "type": {"enum": ["promoter", "rbs", "cds", "terminator"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "instance_id": {"$ref": "#/$defs/local_id"},
        "sequence": {"type": "string", "pattern": "^[ACGTRYSWKMBDHVN]+$"},
        "sequence_sha256": {"$ref": "#/$defs/sha256"},
        "source_sequence_sha256": {"$ref": "#/$defs/sha256"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "source_direction": {"type": "integer", "enum": [-1, 0, 1]},
        "direction": {"type": "integer", "enum": [-1, 0, 1]},
        "placement": {
          "type": "object", "required": ["orientation", "transform", "algorithm"],
          "properties": {"orientation": {"enum": ["forward", "reverse"]}, "transform": {"enum": ["identity", "reverse_complement"]}, "algorithm": {"const": "iupac-dna.v1"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "annotation": {
      "type": "object", "required": ["id", "name", "type", "origin", "anchors", "locations"],
      "properties": {
        "id": {"$ref": "#/$defs/local_id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
        "origin": {"const": "user"},
        "anchors": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/span"}},
        "locations": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/span"}}
      }, "additionalProperties": false
    }
  }
}
