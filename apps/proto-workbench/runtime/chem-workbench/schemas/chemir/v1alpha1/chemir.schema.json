{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chemir.schema.json",
  "title": "ChemIR v1alpha1 core structure-compute document",
  "description": "Top-level document for the v1-core-structure-compute profile.",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "canonicalization",
    "normalization_profile",
    "objects"
  ],
  "properties": {
    "schema_version": {
      "const": "chemir/v1alpha1"
    },
    "profile": {
      "const": "v1-core-structure-compute"
    },
    "canonicalization": {
      "const": "chem-c14n-json-v1alpha1"
    },
    "normalization_profile": {
      "const": "source-preserving/v1alpha1"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "object.schema.json#/$defs/ChemIRObject"
      }
    }
  },
  "additionalProperties": false
}
