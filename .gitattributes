* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.woff binary
*.woff2 binary
*.sqlite binary
*.gz binary

# These byte-pinned fixtures intentionally preserve their upstream EOF shape.
apps/proto-workbench/runtime/trust/sigstore-public-good/trusted_root.json text eol=lf whitespace=-blank-at-eof
apps/proto-workbench/tests/fixtures/sigstore/statement.json text eol=lf whitespace=-blank-at-eof
# Corpus receipts bind upstream bytes, including original mixed line endings.
tests/security_corpus/** -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve exact bytes and upstream whitespace of the sealed Chem source snapshot.
apps/proto-workbench/runtime/chem-workbench/** -text whitespace=-blank-at-eol,-blank-at-eof
# Frozen evaluation bytes are bound to the adjacent SHA-256 digest.
apps/proto-workbench/evaluation/software-tasks.v1.json -text
examples/compute/quantity-counts.data.json -text
examples/compute/quantity-statistics.data.json -text
# Preserve the upstream RCSB mmCIF fixture, including its column whitespace.
apps/proto-workbench/src/renderer/fixtures/1GFL.cif -text whitespace=-blank-at-eol,-blank-at-eof
# Font licenses are byte-pinned alongside the unmodified upstream WOFF2 files.
apps/proto-workbench/src/renderer/assets/fonts/public/*/OFL.txt -text whitespace=-blank-at-eol
apps/proto-workbench/src/renderer/assets/fonts/public/commit-mono/LICENSE-FONT -text whitespace=-blank-at-eol

# These copied dependency licenses are compared byte-for-byte with npm packages.
apps/proto-workbench/licenses/Molstar-MIT.txt -text whitespace=-blank-at-eol,-blank-at-eof
apps/proto-workbench/licenses/LM-Studio-SDK-Apache-2.0.txt -text whitespace=-blank-at-eol,-blank-at-eof
