    {
      "resource_id": "igem:09c8558f-f976-4d04-bd8c-cfd7d8d2d7e2",
      "kind": "genetic_part",
      "name": "BBa_25RT9PC8",
      "aliases": ["The ECF16-cognate promoter P16"],
      "description_en": "The cognate promoter P<sub>16 </sub>for the ECF16 sigma factor contains its specific binding site. Upon binding, the ECF16 sigma factor recruits the E. coli RNA polymerase to initiate transcription of the downstream gene. In our project, P<sub>16</sub> is placed upstream of the GFP reporter gene (BBa_K2717024), serving as the regulatory element that integrates upstream input signals and activates transcription only when the intact ECF16 sigma factor is present, thereby validating the AND-gate logic function.",
