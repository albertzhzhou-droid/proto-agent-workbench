      ]
    },
    {
      "id": "run-design-review",
      "purpose": "Run the design workflow and preserve structured diagnostics and artifacts.",
      "interfaces": [
        {"kind": "mcp", "tool": "proto_workflow_run"}
      ]
    },
    {
      "id": "build-review-packet",
      "purpose": "Create a human-review packet that preserves evidence and safety boundaries.",
      "interfaces": [
        {"kind": "mcp", "tool": "proto_review_packet"}
      ]
    }
  ]
